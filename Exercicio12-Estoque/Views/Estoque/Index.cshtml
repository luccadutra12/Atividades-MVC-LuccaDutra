@model IEnumerable<Exercicio12_Estoque.Models.Produto><h1>Sistema de Estoque</h1><table border="1"><tr><th>Nome</th><th>Categoria</th><th>Estoque</th><th>Preço</th><th>Situação</th></tr>@foreach(var p in Model){<tr><td>@p.Nome</td><td>@p.Categoria</td><td>@p.Estoque</td><td>R$ @p.Preco.ToString("0.00")</td><td>@p.Situacao</td></tr>}</table><p><a href="/Estoque/Index">Todos</a> | <a href="/Estoque/Baixos">Baixo</a> | <a href="/Estoque/Esgotados">Esgotados</a> | <a href="/Estoque/Alertas">Alertas</a></p>
