@model IEnumerable<Exercicio14_Cursos.Models.Curso><h1>Sistema de Cursos</h1><table border="1"><tr><th>Curso</th><th>Carga</th><th>Modalidade</th><th>Vagas</th><th>Valor</th><th>Situação</th></tr>@foreach(var c in Model){<tr><td>@c.Nome</td><td>@c.CargaHoraria h</td><td>@c.Modalidade</td><td>@c.Vagas</td><td>R$ @c.Valor.ToString("0.00")</td><td>@c.Situacao</td></tr>}</table><p><a href="/Curso/Index">Todos</a> | <a href="/Curso/Disponiveis">Disponíveis</a> | <a href="/Curso/Online">Online</a> | <a href="/Curso/Presenciais">Presenciais</a> | <a href="/Curso/Dashboard">Dashboard</a></p>
