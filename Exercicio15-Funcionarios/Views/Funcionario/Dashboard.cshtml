@model IEnumerable<Exercicio15_Funcionarios.Models.Funcionario><h1>Dashboard</h1><p>Total: @Model.Count()</p><p>Ativos: @Model.Count(x=>x.Ativo)</p><p>Inativos: @Model.Count(x=>!x.Ativo)</p><p>Média salarial: R$ @Model.Average(x=>x.Salario).ToString("0.00")</p><p>Maior salário: R$ @Model.Max(x=>x.Salario).ToString("0.00")</p><p>Menor salário: R$ @Model.Min(x=>x.Salario).ToString("0.00")</p>
