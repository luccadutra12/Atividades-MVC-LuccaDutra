@model IEnumerable<Exercicio15_Funcionarios.Models.Funcionario><h1>Cadastro de Funcionários</h1><table border="1"><tr><th>Nome</th><th>Cargo</th><th>Departamento</th><th>Salário</th><th>Situação</th><th>Faixa</th></tr>@foreach(var f in Model){<tr><td>@f.Nome</td><td>@f.Cargo</td><td>@f.Departamento</td><td>R$ @f.Salario.ToString("0.00")</td><td>@f.Situacao</td><td>@f.FaixaSalarial</td></tr>}</table><p><a href="/Funcionario/Index">Todos</a> | <a href="/Funcionario/Ativos">Ativos</a> | <a href="/Funcionario/Inativos">Inativos</a> | <a href="/Funcionario/Departamento?nome=TI">TI</a> | <a href="/Funcionario/Dashboard">Dashboard</a></p>
