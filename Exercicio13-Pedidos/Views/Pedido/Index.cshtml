@model IEnumerable<Exercicio13_Pedidos.Models.Pedido><h1>Sistema de Pedidos</h1><table border="1"><tr><th>Cliente</th><th>Produto</th><th>Qtd.</th><th>Total</th><th>Status</th></tr>@foreach(var p in Model){<tr><td>@p.Cliente</td><td>@p.Produto</td><td>@p.Quantidade</td><td>R$ @p.Total.ToString("0.00")</td><td>@p.Status</td></tr>}</table><p><a href="/Pedido/Index">Todos</a> | <a href="/Pedido/EmPreparo">Em preparo</a> | <a href="/Pedido/Prontos">Prontos</a> | <a href="/Pedido/Entregues">Entregues</a> | <a href="/Pedido/Dashboard">Dashboard</a></p>
